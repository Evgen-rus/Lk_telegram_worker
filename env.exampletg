# Базовый HTTPS-адрес ЛК/backend на РФ-сервере.
# Worker будет обращаться сюда за очередью Telegram-уведомлений.
LK_API_BASE=https://lk.example.ru

# Секретный токен доступа worker-а к internal API ЛК.
# Такое же значение должно быть задано в .env backend-а.
TELEGRAM_WORKER_API_TOKEN=lk_tg_worker_v1_replace_with_long_random_secret

# Токен Telegram-бота. Нужен только worker-у на NL-сервере,
# backend на РФ-сервере Telegram Bot API напрямую не вызывает.
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_bot_token

# Идентификатор этого worker-а. Попадает в lock записей очереди.
WORKER_ID=nl-worker-1

# Как часто worker опрашивает ЛК за новыми уведомлениями, в секундах.
POLL_SECONDS=30

# Сколько уведомлений забирать за один запрос claim.
BATCH_SIZE=50

# Таймаут HTTP-запросов к ЛК и Telegram Bot API, в секундах.
REQUEST_TIMEOUT_SECONDS=20
